# Contoh variabel lingkungan untuk Vercel (Settings -> Environment Variables).
# JANGAN isi nilai asli di berkas ini dan JANGAN commit berkas ".env" berisi kredensial asli.
# Nilai GOOGLE_* dan nama tab sama dengan yang dipakai bot di Render, jadi bisa disalin dari sana.

# --- Google Sheet milik bot (dibaca aplikasi ini) ---
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_TAB=Berita

# --- Login dan sesi ---
# SESSION_SECRET: acak, minimal 32 karakter. Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Password awal akun admin. Setelah diganti lewat menu aplikasi, nilai di Sheet yang dipakai.
ADMIN_PASSWORD=
# Opsional: password awal akun tamu (default "tamu").
TAMU_PASSWORD=
# Opsional: simpan hash password di file Sheet terpisah agar tidak terlihat analis.
USERS_SHEET_ID=

# --- Tombol "Tarik berita" (memicu bot di Render) ---
# Alamat layanan di Render, tanpa garis miring di akhir.
BOT_URL=https://briefing-babel-bot.onrender.com
# Harus sama dengan CRON_SECRET di Render (minimal 16 karakter).
CRON_SECRET=
